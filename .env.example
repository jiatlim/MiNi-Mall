DATABASE_URL="file:./dev.db"

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-me"

# 生产环境默认开启 Secure Cookie；本地如需模拟可设为 true
# COOKIE_SECURE="true"

# 种子管理员（仅演示/开发环境；首次创建时生效）
# 未设置 SEED_ADMIN_PASSWORD 时，首次 seed 使用演示密码 Admin123456
# SEED_ADMIN_EMAIL="admin@mini.mall"
# SEED_ADMIN_PASSWORD="change-me-before-seeding"
# SEED_ADMIN_RESET_PASSWORD="false"
